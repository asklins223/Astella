{
  "name": "@astella/ai-worker",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=8 $(find src -name '*.test.ts' | sort)",
    "test:companion-dialogue:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-dialogue-postgres.integration.ts",
    "test:agent-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/agent-goals-postgres.integration.ts src/integration-tests/agent-history-postgres.integration.ts src/integration-tests/agent-expansion-postgres.integration.ts src/integration-tests/agent-learning-preferences-postgres.integration.ts src/integration-tests/agent-card-generation-postgres.integration.ts src/integration-tests/agent-growth-postgres.integration.ts src/integration-tests/agent-long-goals-postgres.integration.ts",
    "test:companion-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-scheduler-ticks-postgres.integration.ts src/integration-tests/companion-memory-handlers-postgres.integration.ts src/integration-tests/companion-agent-postgres.integration.ts src/integration-tests/companion-dialogue-postgres.integration.ts src/integration-tests/companion-memory-semantic-dismissal-postgres.integration.ts src/integration-tests/companion-turn-facts-postgres.integration.ts src/integration-tests/companion-answer-exposure-postgres.integration.ts src/integration-tests/companion-thought-candidate-postgres.integration.ts src/integration-tests/companion-read-pagination-task-memory-postgres.integration.ts src/integration-tests/companion-memory-cross-space.integration.ts src/integration-tests/companion-note-visibility-postgres.integration.ts src/integration-tests/companion-failed-partial-postgres.integration.ts src/integration-tests/companion-runtime-recovery-postgres.integration.ts src/integration-tests/companion-diary-array-parameter-postgres.integration.ts src/integration-tests/companion-model-budget-postgres.integration.ts",
    "test:platform-live:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/opencode-go-live.integration.ts",
    "test:card-generation-v3:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/card-generation-v3-simplified-postgres.integration.ts",
    "test:objective-reuse:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/objective-reuse-lookup-postgres.integration.ts",
    "test:parse-source-rls:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/parse-source-rls-context-postgres.integration.ts",
    "test:ai-audit-rls:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/ai-audit-rls-context-postgres.integration.ts",
    "test:cross-module-drill:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/cross-module-same-process-drill.postgres.integration.ts",
    "test:plan44-cooldown:postgres": "node --import tsx --test --test-concurrency=1 --test-force-exit src/integration-tests/plan44-compaction-cooldown-postgres.integration.ts",
    "test:plan44-summary-commit:postgres": "node --import tsx --test --test-concurrency=1 --test-force-exit src/integration-tests/plan44-summary-commit-fencing-postgres.integration.ts",
    "test:card-generation-v2-lifecycle:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/card-generation-v2-e2e-subset.integration.ts src/integration-tests/card-generation-v2-c-cases.integration.ts src/integration-tests/card-generation-v2-redaction-quota.integration.ts",
    "test:ai-task-kernel:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/ai-task-kernel-postgres.integration.ts",
    "test:public-http-gate:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/public-http-gate-postgres.integration.ts",
    "test:shared-foundation-vertical-slice:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/shared-foundation-vertical-slice-postgres.integration.ts"
  },
  "dependencies": {
    "@astella/agent-core": "file:../../packages/agent-core",
    "@astella/agent-host": "file:../../packages/agent-host",
    "@astella/ai-quality": "file:../../packages/ai-quality",
    "@astella/card-generation": "file:../../packages/card-generation",
    "@astella/shared": "file:../../packages/shared",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@huggingface/tokenizers": "0.2.0",
    "@smithy/node-http-handler": "^4.9.9",
    "drizzle-orm": "^0.45.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.0",
    "undici": "^7.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
