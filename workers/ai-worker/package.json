{
  "name": "@astella/ai-worker",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=8 $(find src -name '*.test.ts' | sort)",
    "test:companion-initiative:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-initiative-postgres.integration.ts",
    "test:companion-speculative:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-speculative-loop-postgres.integration.ts",
    "test:agent-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/agent-history-postgres.integration.ts src/integration-tests/agent-expansion-postgres.integration.ts src/integration-tests/agent-learning-preferences-postgres.integration.ts src/integration-tests/agent-growth-postgres.integration.ts src/integration-tests/agent-long-goals-postgres.integration.ts",
    "test:companion-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-scheduler-ticks-postgres.integration.ts src/integration-tests/companion-memory-handlers-postgres.integration.ts src/integration-tests/companion-agent-postgres.integration.ts src/integration-tests/companion-memory-semantic-dismissal-postgres.integration.ts src/integration-tests/companion-read-pagination-task-memory-postgres.integration.ts src/integration-tests/companion-memory-cross-space.integration.ts src/integration-tests/companion-note-visibility-postgres.integration.ts src/integration-tests/companion-failed-partial-postgres.integration.ts src/integration-tests/companion-runtime-recovery-postgres.integration.ts src/integration-tests/companion-diary-array-parameter-postgres.integration.ts src/integration-tests/companion-model-budget-postgres.integration.ts src/integration-tests/companion-initiative-postgres.integration.ts src/integration-tests/companion-diary-material-original-postgres.integration.ts src/integration-tests/companion-diary-writing-postgres.integration.ts src/integration-tests/companion-memory-embedding-original-postgres.integration.ts src/integration-tests/companion-note-authoring-postgres.integration.ts src/integration-tests/companion-note-share-postgres.integration.ts src/integration-tests/companion-followup-suggestions-postgres.integration.ts src/integration-tests/companion-run-reclaim-postgres.integration.ts src/integration-tests/companion-voice-dialect-preference-postgres.integration.ts src/integration-tests/companion-annotation-authoring-postgres.integration.ts src/integration-tests/companion-review-fences-postgres.integration.ts src/integration-tests/companion-complete-summary-postgres.integration.ts src/integration-tests/companion-history-retrieval-postgres.integration.ts src/integration-tests/journey-milestones-postgres.integration.ts",
    "test:platform-live:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/opencode-go-live.integration.ts",
    "test:parse-source-rls:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/parse-source-rls-context-postgres.integration.ts",
    "test:ai-audit-rls:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/ai-audit-rls-context-postgres.integration.ts",
    "test:plan44-cooldown:postgres": "node --import tsx --test --test-concurrency=1 --test-force-exit src/integration-tests/plan44-compaction-cooldown-postgres.integration.ts",
    "test:plan44-summary-commit:postgres": "node --import tsx --test --test-concurrency=1 --test-force-exit src/integration-tests/plan44-summary-commit-fencing-postgres.integration.ts",
    "test:ai-task-kernel:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/ai-task-kernel-postgres.integration.ts",
    "test:public-http-gate:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/public-http-gate-postgres.integration.ts",
    "test:long-job-lease:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/long-job-lease-postgres.integration.ts",
    "test:note-mind-map:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/note-mind-map-postgres.integration.ts",
    "test:companion-tool-review:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-tool-review-postgres.integration.ts",
    "test:queue:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/queue-postgres.integration.ts"
  },
  "dependencies": {
    "@astella/agent-core": "file:../../packages/agent-core",
    "@astella/agent-host": "file:../../packages/agent-host",
    "@astella/ai-quality": "file:../../packages/ai-quality",
    "@astella/shared": "file:../../packages/shared",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@huggingface/tokenizers": "0.2.0",
    "@smithy/node-http-handler": "^4.9.9",
    "drizzle-orm": "^0.45.2",
    "pino": "^9.5.0",
