{
  "name": "@ailearn/ai-worker",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=8 $(find src -name '*.test.ts' | sort)",
    "test:companion-dialogue:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-dialogue-postgres.integration.ts",
    "test:agent-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/agent-goals-postgres.integration.ts src/integration-tests/agent-history-postgres.integration.ts src/integration-tests/agent-expansion-postgres.integration.ts src/integration-tests/agent-learning-preferences-postgres.integration.ts",
    "test:companion-integration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-scheduler-ticks-postgres.integration.ts src/integration-tests/companion-memory-handlers-postgres.integration.ts src/integration-tests/companion-agent-postgres.integration.ts src/integration-tests/companion-dialogue-postgres.integration.ts src/integration-tests/companion-memory-semantic-dismissal-postgres.integration.ts src/integration-tests/companion-turn-facts-postgres.integration.ts src/integration-tests/companion-answer-exposure-postgres.integration.ts src/integration-tests/companion-thought-candidate-postgres.integration.ts src/integration-tests/companion-read-pagination-task-memory-postgres.integration.ts src/integration-tests/companion-memory-cross-space.integration.ts src/integration-tests/companion-note-visibility-postgres.integration.ts src/integration-tests/companion-failed-partial-postgres.integration.ts src/integration-tests/companion-runtime-recovery-postgres.integration.ts",
    "test:platform-live:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/opencode-go-live.integration.ts",
    "test:card-generation-v3:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/card-generation-v3-simplified-postgres.integration.ts",
    "test:objective-reuse:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/objective-reuse-lookup-postgres.integration.ts",
    "test:parse-source-rls:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/parse-source-rls-context-postgres.integration.ts",
    "test:ai-audit-rls:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/ai-audit-rls-context-postgres.integration.ts",
    "test:cross-module-drill:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/cross-module-same-process-drill.postgres.integration.ts"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@ailearn/card-generation": "file:../../packages/card-generation",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@smithy/node-http-handler": "^4.9.9",
    "drizzle-orm": "^0.45.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.0",
    "undici": "^7.29.0",
    "zod": "^3.23.8",
    "@ailearn/agent-core": "file:../../packages/agent-core",
    "@ailearn/agent-host": "file:../../packages/agent-host"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
