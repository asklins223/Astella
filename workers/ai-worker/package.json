    "prom-client": "^15.1.0",
    "undici": "^7.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.19.0"
  }
}
