{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "noEmit": true,
    "paths": {
      "@astella/shared/db-schema": ["../shared/src/db-schema/index.ts"],
      "@astella/shared/db-schema/*": ["../shared/src/db-schema/*.ts"],
      "@astella/shared/card-generation-v2-contracts": ["../shared/src/contracts/card-generation-v2-contracts.ts"],
      "@astella/shared/card-generation-v2-hashing": ["../shared/src/card-generation-v2-hashing.ts"],
      "@astella/shared/card-generation-v2-pipeline": ["../shared/src/card-generation-v2-pipeline/index.ts"],
      "@astella/shared/hash-canonical-v2": ["../shared/src/hash-canonical-v2.ts"],
      "@astella/shared/note-visibility-condition": ["../shared/src/note-visibility-condition.ts"],
      "@astella/shared": ["../shared/src/index.ts"],
      "@astella/shared/*": [
        "../shared/src/contracts/agent/*.ts",
        "../shared/src/contracts/companion/*.ts",
        "../shared/src/contracts/note/*.ts",
        "../shared/src/contracts/learning/*.ts",
        "../shared/src/contracts/desktop/*.ts",
        "../shared/src/agent/*.ts",
        "../shared/src/companion/*.ts",
        "../shared/src/note/*.ts",
        "../shared/src/review/*.ts",
        "../shared/src/platform/*.ts",
        "../shared/src/content/*.ts",
        "../shared/src/contracts/*.ts",
        "../shared/src/*.ts",
        "../shared/src/*/index.ts"
      ],
      "drizzle-orm": ["./node_modules/drizzle-orm/index.d.ts"],
      "drizzle-orm/*": ["./node_modules/drizzle-orm/*/index.d.ts", "./node_modules/drizzle-orm/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}