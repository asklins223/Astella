    {
      "id": "quality-bayes",
      "repeat": 0,
      "prompt": "一种病患病率2%，检测试剂敏感度80%，未患病者误报率10%。随机一人测出阳性，他患病的概率是多少？请把假阳性也计入，写出推导。",
      "runId": "7c061c98-e99d-4dfb-b9c7-6246bca5e69a",
      "ok": true,
      "checks": {
        "succeeded": true,
