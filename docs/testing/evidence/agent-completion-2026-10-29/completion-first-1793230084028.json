            "policyHash": "d16669dd64dc80a8779b6f77ca1fb43cf51aef9a3169b485d964578bdfbc9c5f"
          }
        },
        "created_at": "2026-10-28T23:28:14.459Z",
        "started_at": "2026-10-28T23:28:14.555Z",
        "actual_steps": "3"
      },
      "calls": [
        {
          "name": "observe.calculate",
          "status": "succeeded",
          "risk_class": "read"
        }
      ],
      "hostReads": [],
      "providerCalls": [
        {
          "provider": "openai_compatible",
          "operation": "companion_agent:chat_completion",
          "duration_ms": 688,
          "prompt_tokens": 615,
          "completion_tokens": 5,
