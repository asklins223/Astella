    {
      "id": "bayes",
      "prompt": "一种病患病率2%，试剂敏感度80%，未患病者误报率10%。随机一人阳性，他患病概率多少？请把假阳性计入并推导。",
      "runId": "ce31ecf1-10d7-4ab8-9c00-a6218f2d09a3",
      "run": {
        "status": "succeeded",
        "errorCode": null,
        "route": {
          "version": 1,
          "workload": "adaptive",
