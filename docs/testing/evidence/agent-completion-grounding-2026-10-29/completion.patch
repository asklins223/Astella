+        catch (error) {
+          args.ctx.signal.throwIfAborted();
+          if (isNonRetryableError(error) || error instanceof JobLeaseLostError) throw error;
+        }
+        args.ctx.signal.throwIfAborted();
+        if (verdict.decision !== "unavailable") break;
+      }
+      cache.set(key, verdict);
+      return verdict;
+    },
+  };
+}
