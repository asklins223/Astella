+test("two publications plus premature close resumes only the missing third, including process recovery", async () => {
+  const f = await fixture("分三条独立消息，依次发春、夏、秋。");
+  let step = 0, crash = true;
+  const p = providers(f.args, async request => {
+    step++;
+    if (step === 1) return { content: "", toolCalls: [
+      { id: "spring", name: "companion_send_message", arguments: { text: "春" } },
+      { id: "summer", name: "companion_send_message", arguments: { text: "夏" } }], finishReason: "tool_calls" };
+    if (crash) {
+      crash = false;
+      await f.mutate(tx => tx`UPDATE jobs SET lease_token='reclaimed-completion-lease' WHERE id=${f.jobId}`);
+      throw new JobLeaseLostError(f.jobId, "inactive");
+    }
+    if (step === 3) return { content: "已发完。", toolCalls: [], finishReason: "stop" };
+    if (step === 4) return call("autumn", "companion_send_message", { text: "秋" });
+    return finish("春 夏 秋", request.messages, f.args.read.userText);
+  }, proof => proof.phase === "effects" || proof.sources.filter(source => source.kind === "published").length === 3
+    ? approved(proof) : rejected(proof, "实际只发布两条，仍缺秋；不要重发春和夏"));
+  await assert.rejects(runCompanionAgentLoop(f.args), JobLeaseLostError);
+  assert.equal((await f.state()).messages.length, 2);
+  assert.equal((await f.state()).steps.at(-1)!.status, "running", "lost attempt cannot terminalize the new owner's step");
+  f.args.ctx.leaseToken = "reclaimed-completion-lease";
+  const checkpoint = (await f.state()).steps.at(-1)!.runtime_checkpoint;
+  const identity = companionRecoveryIdentity({ args: f.args, currentRequest: openCompanionTurn(f.args).currentRequest,
+    permissionLevel: "full", primary: f.args.provider, fallback: f.args.fallbackProvider!,
+    definitions: resolveAllCompanionAgentTools("full", { webSearchEnabled: false, noteLibraryReadEnabled: true })
+      .filter(definition => companionCapabilityOfferedInHostContext(definition, { writingAnnotation: false, completeNoteReply: false, initiative: false })) });
+  assert.equal(checkpoint.identitySha256, sha256Utf8V1(stableStringify(identity)), "recovery identity is stable");
+  const recoveredState = companionRuntimeStateSchema.safeParse(JSON.parse(checkpoint.stateJson).state);
+  assert.ok(recoveredState.success, recoveredState.success ? "" : JSON.stringify(recoveredState.error.issues));
+  const result = await runCompanionAgentLoop(f.args);
+  assert.equal(result.status, "completed"); if (result.status !== "completed") return;
+  assert.equal(result.text, "", "all three actual publications are not repeated in final prose");
+  const state = await f.state();
+  assert.deepEqual(state.messages.map(row => row.blocks[0].text), ["春", "夏", "秋"]);
+  assert.equal(state.calls.filter(row => row.name === "say.publish" && row.status === "succeeded").length, 3);
+  const completion = p.all.filter(proof => proof.phase === "completion");
+  assert.deepEqual(completion.map(proof => proof.sources.filter(source => source.kind === "published").length), [2, 2, 3], "both premature auto-close and resumed premature final are reviewed");
+});
