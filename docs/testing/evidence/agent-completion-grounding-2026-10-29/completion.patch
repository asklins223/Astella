+type ScriptedTurn = Omit<AgentTurnResult, "usage" | "providerRequestId">;
+const call = (id: string, name: string, arguments_: Record<string, unknown>): ScriptedTurn =>
+  ({ content: "", toolCalls: [{ id, name, arguments: arguments_ }], finishReason: "tool_calls" });
+const approved = (proof: CompletionAuditInput): CompletionAuditVerdict => ({ decision: "release", checks: [{
+  requestSpan: proof.request, status: "satisfied", basis: [{ sourceId: "request", quote: proof.request }], conclusion: "夹具核对通过" }], findings: [] });
+const rejected = (proof: CompletionAuditInput, problem: string): CompletionAuditVerdict => ({ decision: "revise", checks: [], findings: [{
+  requestSpan: proof.request, candidateSpan: null, basis: [], problem }] });
+function providers(args: CompanionAgentLoopArgs, execute: (request: AgentTurnRequest) => Promise<ScriptedTurn> | ScriptedTurn,
+  audit: (proof: CompletionAuditInput) => Promise<CompletionAuditVerdict> | CompletionAuditVerdict) {
+  let steps = 0, reviews = 0;
+  const all: CompletionAuditInput[] = [];
+  const make = (identity: string) => Object.assign(new MockProvider(), { id: identity, modelId: identity,
+    executeAgentTurn: async (request: AgentTurnRequest) => { if (++steps > 12) throw new Error("fixture exceeded expected native calls"); return { usage: { totalTokens: 1, promptTokens: 1, completionTokens: 0, requestId: null }, providerRequestId: "test-request", ...await execute(request) }; },
+    chatCompletion: async (messages: ChatMessage[]) => {
+      const raw = messages.find(message => message.role === "user")?.content;
+      const input = JSON.parse(String(raw)) as CompletionAuditInput;
+      if (!input.phase) return { content: '{"path":"chat"}' };
+      reviews++; all.push(input);
+      return { content: JSON.stringify(await audit(input)) };
+    },
+  });
+  args.provider = make("completion-primary"); args.fallbackProvider = make("completion-independent");
+  return { all, get steps() { return steps; }, get reviews() { return reviews; } };
+}
+const receiptIds = (messages: AgentTurnRequest["messages"]) => messages.filter(message => message.role === "tool"
+  && JSON.parse(String(message.content)).ok === true).map(message => message.toolCallId!);
+const finish = (text: string, messages: AgentTurnRequest["messages"], requirement: string) => call("finish_" + randomUUID(), "companion_finish", {
+  text, actions: currentCompanionSuccessfulReceipts(messages).filter(receipt => receipt.riskClass !== "read")
+    .map(receipt => ({ receiptId: receipt.id })), outcome: "completed",
+  requirements: [{ requirement, fulfilled: true, evidenceCallIds: receiptIds(messages), textOnly: false }],
+});
