+test("zero-read textOnly finish cannot publish invented private data; real read repairs without fabricated assistant history", async () => {
+  const f = await fixture("读取私人笔记，告诉我暗号。");
+  const secret = "actual-" + randomUUID();
+  const note = await withWorkspaceTransaction(f.scope, tx => createNote(tx, f.scope.workspaceId, f.scope.userId,
+    { title: "私人笔记", blocks: [{ type: "paragraph", content: secret }] }));
+  let step = 0, nativeCheckpointObserved = false;
+  const p = providers(f.args, request => {
+    step++;
+    if (step === 1) return call("false_finish", "companion_finish", { text: "暗号是 INVENTED。", actions: [], evidence: [],
+      outcome: "completed", requirements: [{ requirement: f.args.read.userText, fulfilled: true, textOnly: true, evidenceCallIds: [] }] });
+    assert.ok(!request.messages.some(message => message.role === "assistant" && String(message.content).includes("INVENTED")));
+    if (step === 2) return call("load_notes", "companion_load_tools", { groups: ["notes"] });
+    if (step === 3) return call("real_read", "companion_notes_read", { action: "read", noteId: note!.note.id });
+    return { content: "真实暗号是 " + secret + "。", toolCalls: [], finishReason: "stop" };
+  }, async proof => {
+    const [running] = await f.mutate(tx => tx`SELECT checkpoint FROM companion_agent_steps WHERE run_id=${f.runId} AND status='running'`);
+    assert.ok(running?.checkpoint, "native result is retained while independent audit runs");
+    assert.ok(!JSON.stringify(running.checkpoint).includes('"decision"'), "audit must not overwrite native checkpoint");
+    nativeCheckpointObserved = true;
+    return proof.sources.some(source => source.kind === "receipt" && source.text.includes(secret))
+      ? approved(proof) : rejected(proof, "私人正文尚未读取，不能交付编造暗号");
+  });
+  const result = await runCompanionAgentLoop(f.args);
+  assert.equal(result.status, "completed"); if (result.status !== "completed") return;
+  assert.match(result.text, new RegExp(secret)); assert.doesNotMatch(result.text, /INVENTED/);
+  const state = await f.state(); assert.equal(state.messages.length, 0);
+  assert.equal(state.calls.filter(row => row.name === "notes.read.read" && row.status === "succeeded").length, 1);
+  assert.equal(p.reviews, 2); assert.equal(nativeCheckpointObserved, true);
+});
