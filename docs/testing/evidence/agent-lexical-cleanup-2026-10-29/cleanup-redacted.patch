-function bestByCoverage<T>(rows: T[], terms: string[], textOf: (row: T) => string): T | null {
-  let best: T | null = null;
-  let bestScore = 0;
-  for (const row of rows) {
-    const score = coverage(textOf(row), terms);
-    if (score > bestScore) {
-      best = row;
-      bestScore = score;
-    }
-  }
-  return bestScore >= TURN_FACT_MIN_COVERAGE ? best : null;
-}
