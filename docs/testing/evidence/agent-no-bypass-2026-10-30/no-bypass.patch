+test("a legacy settled checkpoint without review provenance is rechecked and repaired before delivery", async () => {
+  const f = await fixture("读取私人笔记告诉我口令。");
+  const secret = "actual-" + randomUUID();
+  const note = await withWorkspaceTransaction(f.scope, tx => createNote(tx, f.scope.workspaceId, f.scope.userId,
+    { title: "私人笔记", blocks: [{ type: "paragraph", content: secret }] }));
+  let seed = true, native = 0;
+  const p = providers(f.args, () => {
+    if (++native === 1) return { content: "尚未取得笔记正文。", toolCalls: [], finishReason: "stop" };
+    if (native === 2) return call("legacy_load", "companion_load_tools", { groups: ["notes"] });
+    if (native === 3) return call("legacy_read", "companion_notes_read", { action: "read", noteId: note!.note.id });
+    return { content: "真实口令是 " + secret + "。", toolCalls: [], finishReason: "stop" };
+  }, proof => seed || !proof.candidate.text.includes("LEGACY_INVENTED") ? approved(proof) : rejected(proof, "旧缓存没有私人正文来源"));
+  await runCompanionAgentLoop(f.args);
+  seed = false;
+  const state = await f.state();
+  const envelope = state.steps.at(-1)!.runtime_checkpoint;
+  const snapshot = JSON.parse(envelope.stateJson);
+  assert.equal(snapshot.phase, "settled");
+  delete snapshot.deliveryReviewPolicy;
+  snapshot.result.text = "旧版零读取口令是 LEGACY_INVENTED。";
+  snapshot.state.visibleSegments = [snapshot.result.text]; snapshot.state.visibleSegmentDelivered = [false];
+  const stateJson = stableStringify(snapshot);
+  await f.mutate(tx => tx`UPDATE companion_agent_steps SET runtime_checkpoint=${tx.json({ ...envelope, stateJson, stateSha256: sha256Utf8V1(stateJson) })}
+    WHERE id=(SELECT id FROM companion_agent_steps WHERE run_id=${f.runId} ORDER BY step_no DESC LIMIT 1)`);
+  const result = await runCompanionAgentLoop(f.args);
+  assert.equal(result.status, "completed");
+  if (result.status === "completed") { assert.match(result.text, new RegExp(secret)); assert.doesNotMatch(result.text, /INVENTED/); }
+  assert.equal(p.reviews, 3);
+  assert.equal((await f.state()).calls.filter(row => row.name === "notes.read.read" && row.status === "succeeded").length, 1);
+  const final = await f.state();
+  assert.ok(JSON.parse(final.steps.at(-1)!.runtime_checkpoint.stateJson).deliveryReviewPolicy);
+  const attempts = p.steps;
+  await runCompanionAgentLoop(f.args);
+  assert.equal(p.reviews, 3, "a current reviewed checkpoint stays idempotent");
+  assert.equal(p.steps, attempts);
+});
