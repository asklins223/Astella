{
  "name": "ailearn-desktop-client",
  "version": "0.1.0",
  "description": "理解引擎 immersive desktop study room",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "dev:watch-main": "electron-vite dev -w --remoteDebuggingPort 9222",
    "build": "npm run validate:room-layers && electron-vite build && npm run validate:room-layers:output",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run --passWithNoTests",
    "validate:room-layers": "node scripts/validate-room-layers.mjs",
    "validate:room-layers:output": "node scripts/validate-room-layers.mjs --manifest out/renderer/assets/learning-room/v1/manifest.json --runtime-root out/renderer/assets/learning-room/v1 --source-manifest src/renderer/public/assets/learning-room/v1/manifest.json --source-root src/renderer/public/assets/learning-room/v1",
    "generate:home-scene-assets": "node scripts/extract-room-scene-assets.mjs --spec apps/desktop-client/scripts/fixtures/lighthouse-home-scene-assets.input.json",
    "sync:home-scene-manifest": "node scripts/sync-room-scene-manifest.mjs --spec apps/desktop-client/scripts/fixtures/lighthouse-home-scene-assets.input.json",
    "capture": "node scripts/capture-scene.mjs",
    "capture:home-v2": "VITE_HOME_SCENE_VARIANT=v2 npm run build && node scripts/capture-home-v2-lighthouse.mjs",
    "capture:evidence": "npm run build && node scripts/capture-evidence.mjs",
    "evidence:manifest": "node --experimental-strip-types scripts/evidence-manifest.ts --input scripts/fixtures/evidence-manifest.input.json --output .impeccable/evidence/manifest.json --root ../..",
    "package:smoke": "node scripts/smoke-packaged.mjs",
    "package:evidence": "npm run package:smoke && node scripts/package-evidence.mjs",
    "package:win:x64": "npm run build && electron-builder --win --x64",
    "package:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "npm run build && electron-builder --mac --x64",
    "package:linux:x64": "npm run build && electron-builder --linux --x64",
    "preview": "electron-vite preview",
    "dist": "npm run typecheck && npm run test && npm run build && electron-builder"
  },
  "dependencies": {
    "@ailearn/shared": "file:../../packages/shared",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hocuspocus/provider": "^4.7.0",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "katex": "0.18.7",
    "lucide-react": "^1.33.0",
    "pixi.js": "^8.20.1",
    "prosemirror-model": "^1.25.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "ws": "^8.21.3",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^16.4.7",
    "electron": "43.4.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "//": "编辑器栈共用同一份 `prosemirror-model`。`prosemirror-commands` / `prosemirror-drop-indicator` / `zwitch` 各自锁了一个版本；不统一的话测试与运行时都会拿到两套 Schema，然后报 `RangeError: Can not convert <paragraph(…)> to a Fragment (looks like multiple versions of prosemirror-model were loaded)`。**统一版本是这类报错的正解**，alias 只是掩盖它。",
    "overrides": {
      "prosemirror-model": "1.25.11"
    }
  }
}
