<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 文件属性里写清产品名：任务管理器和资源管理器都靠它认人，未签名包更需要能被用户认出来。 -->
    <Product>拾星笔记</Product>
    <Description>拾星笔记 Windows 安装程序</Description>
    <Company>asklins223</Company>
    <Copyright>PolyForm Noncommercial 1.0.0</Copyright>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageLicenseExpression>PolyForm-Noncommercial-1.0.0</PackageLicenseExpression>
    <AssemblyName>AstellaSetup</AssemblyName>
    <ApplicationIcon>../desktop-client/build/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>Astella.Setup.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core/**/*.cs;Core.Tests/**/*.cs" />
    <ProjectReference Include="Core/Astella.Setup.Core.csproj" />
    <Resource Include="../desktop-client/build/icon.png" Link="Resources/icon.png" />
    <EmbeddedResource Include="Resources/usage.txt" LogicalName="Astella.Setup.usage.txt" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Astella.Setup.license.txt" />
  </ItemGroup>
</Project>
