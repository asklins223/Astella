                <GeometryDrawing Brush="#FFF9E9" Geometry="M77,26 A3,3 0 1 1 76.9,26 Z M196,111 A3,3 0 1 1 195.9,111 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
