        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H240 V196 H0 Z" />
                <GeometryDrawing Brush="#D4E3CE" Geometry="M120,12 A83,83 0 1 1 119.9,12 Z" />
                <GeometryDrawing Brush="#F1F5E9" Geometry="M54,41 A13,13 0 1 1 53.9,41 Z" />
                <GeometryDrawing Brush="#C3D5BF" Geometry="M29,171 C29,161 211,161 211,171 C211,183 29,183 29,171 Z" />
                <GeometryDrawing Brush="#75987C" Geometry="M28,94 Q28,84 38,85 L120,104 L202,85 Q212,84 212,94 L212,159 Q210,167 200,165 L120,149 L40,165 Q28,167 28,156 Z" />
                <GeometryDrawing Brush="#D9D8B9" Geometry="M34,91 L120,109 L206,91 L206,158 L120,145 L34,158 Z" />
                <GeometryDrawing Brush="#FFF9E9" Geometry="M37,83 Q77,76 120,99 L120,143 Q79,124 37,146 Z" />
                <GeometryDrawing Brush="#FFFEF5" Geometry="M120,99 Q163,76 203,83 L203,146 Q163,124 120,143 Z" />
                <GeometryDrawing Geometry="M120,100 L120,141 M52,98 Q79,95 104,107 M52,110 Q79,107 103,119 M52,122 Q75,119 92,126 M136,107 Q161,95 187,98 M136,119 Q161,107 187,110 M145,128 Q166,119 186,122">
                    <GeometryDrawing.Pen><Pen Brush="#CBD4BE" Thickness="2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#EFAE92" Geometry="M169,85 L181,83 L181,112 L175,107 L169,114 Z" />
                <GeometryDrawing Geometry="M119,98 C116,76 121,62 137,45">
                    <GeometryDrawing.Pen><Pen Brush="#74947A" Thickness="3" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#91AF8D" Geometry="M122,77 Q97,75 101,56 Q120,55 122,77 Z M127,62 Q145,63 149,45 Q130,40 127,62 Z" />
                <GeometryDrawing Brush="#F3C778" Geometry="M165,22 Q167,40 183,44 Q166,48 163,64 Q161,48 145,45 Q161,40 165,22 Z" />
                <GeometryDrawing Brush="#FFF6D4" Geometry="M164,33 L168,44 L163,53 L159,45 Z" />
