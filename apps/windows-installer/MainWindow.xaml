<Window x:Class="Astella.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="拾星笔记" Width="900" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei" FontSize="14" Foreground="#304C43" Background="#FFFCF4">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="16" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Background" Value="#366453" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#DEAD63" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EAF1E7" /><Setter Property="Foreground" Value="#366453" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,12,0,0" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="CheckBorder" Width="18" Height="18" CornerRadius="5" Background="#FFFCF4" BorderThickness="1.5" BorderBrush="#8AA795" VerticalAlignment="Center">
                        <Path x:Name="CheckMark" Data="M3,8 L7,12 L14,4" Stroke="#FFFFFF" StrokeThickness="2" Visibility="Collapsed" />
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="#366453" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="#DEAD63" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TextBlock Text="ASTELLA / 拾星笔记" FontSize="11" Foreground="#6F8274" Margin="28,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,10,4" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="—" Click="Minimize_Click" Style="{StaticResource Secondary}" Padding="12,4" Margin="0,0,6,0" AutomationProperties.Name="最小化" />
            <Button x:Name="CloseButton" Content="×" Click="Close_Click" Style="{StaticResource Secondary}" Padding="12,4" AutomationProperties.Name="关闭" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="18,8,18,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border CornerRadius="22" Background="#DFEDE1" Padding="26,30">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Image Source="Resources/icon.png" Width="58" Height="58" HorizontalAlignment="Left" Margin="-4,0,0,20" />
                        <TextBlock Text="拾星笔记" FontSize="27" FontWeight="Bold" />
                        <TextBlock Text="安放想法，慢慢生长。" Foreground="#688276" Margin="0,10,0,0" FontSize="13" />
                        <TextBlock x:Name="VersionText" Foreground="#688276" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock x:Name="StepOne" Text="01   认识书房" FontWeight="SemiBold" Margin="0,0,0,22" />
                        <TextBlock x:Name="StepTwo" Text="02   安放在这里" Foreground="#7B9588" Margin="0,0,0,22" />
                        <TextBlock x:Name="StepThree" Text="03   准备出发" Foreground="#7B9588" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Canvas x:Name="BookIllustration" Width="160" Height="106" HorizontalAlignment="Left">
                            <Ellipse Width="154" Height="18" Fill="#C7DCCE" Canvas.Top="88" />
                            <Border Width="120" Height="69" Background="#FFF9EB" CornerRadius="8" Canvas.Left="13" Canvas.Top="25" BorderBrush="#86AA95" BorderThickness="2" />
                            <Path Data="M73,29 L73,90 M26,48 L60,48 M26,60 L57,60 M26,72 L52,72 M85,48 L119,48 M85,60 L117,60 M85,72 L109,72" Stroke="#A5BBAA" StrokeThickness="2" />
                            <Path Data="M120,5 L124,16 L136,17 L127,24 L130,36 L120,29 L110,36 L113,24 L104,17 L116,16 Z" Fill="#E9B666" Stroke="#D1A365" StrokeThickness="1" />
                        </Canvas>
                        <TextBlock Text="你的下一颗灵感，&#10;从这里开始。" FontSize="12" Foreground="#6A8377" Margin="0,14,0,0" LineHeight="21" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="34,12,16,0">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="76" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="NoticePanel">
                        <TextBlock x:Name="NoticeTitle" Text="给学习，安一个家" FontSize="30" FontWeight="Bold" Margin="0,10,0,12" />
                        <TextBlock Text="先了解书房如何保存资料、使用 AI，以及更新和卸载。" Foreground="#7A8174" Margin="0,0,0,20" />
                        <Border CornerRadius="14" Background="#F2F1E7" Padding="18">
                            <ScrollViewer Height="248" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" AutomationProperties.Name="用户使用须知全文">
                                <TextBlock x:Name="UsageText" FontSize="12" LineHeight="22" Foreground="#52665A" />
                            </ScrollViewer>
                        </Border>
                        <CheckBox x:Name="AcceptNotice" Content="我已阅读并同意用户使用须知及非商用许可" Checked="Acceptance_Changed" Unchecked="Acceptance_Changed" />
                        <Button Content="阅读许可全文 ↗" Background="Transparent" Foreground="#557563" FontSize="12" Padding="0,10" HorizontalAlignment="Left" Click="License_Click" />
                    </StackPanel>
                    <StackPanel x:Name="LocationPanel" Visibility="Collapsed">
                        <TextBlock Text="书房放在哪里？" FontSize="30" FontWeight="Bold" Margin="0,10,0,12" />
                        <TextBlock Text="选择一个本机文件夹，程序和个人资料各有位置。" Foreground="#7A8174" Margin="0,0,0,30" />
                        <TextBlock Text="安装位置" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border CornerRadius="12" Background="#F2F1E7" Padding="14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallDirectory" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Padding="0,6" Margin="0,0,12,0" AutomationProperties.Name="安装文件夹" TextChanged="Directory_Changed" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="更改…" Style="{StaticResource Secondary}" Padding="14,8" Click="Browse_Click" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="LocationHint" Foreground="#7A8174" FontSize="12" Margin="0,14,0,20" LineHeight="22" />
                        <CheckBox x:Name="CreateDesktopShortcut" Content="在桌面放一个书房入口" IsChecked="True" />
                        <Border BorderThickness="0,1,0,0" BorderBrush="#E2E5D8" Margin="0,26,0,0" Padding="0,22,0,0">
                            <StackPanel>
                                <TextBlock Text="本机资料单独保存" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="草稿、缓存和语音模型保存在 %APPDATA%\astella-desktop-client；账号里的笔记不随程序目录移动。" FontSize="12" LineHeight="22" Foreground="#7A8174" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,-30,0,0">
                        <TextBlock x:Name="ProgressTitle" Text="正在安放你的书房" FontSize="30" FontWeight="Bold" Margin="0,0,0,16" />
                        <TextBlock x:Name="ProgressMessage" Text="正在准备文件" Foreground="#7A8174" Margin="0,0,0,30" />
                        <ProgressBar x:Name="InstallProgressBar" Height="12" Minimum="0" Maximum="100" Foreground="#72A18A" Background="#E6EBDF" BorderThickness="0" />
                        <TextBlock x:Name="ProgressPercent" Text="0%" Margin="0,12,0,0" Foreground="#688276" HorizontalAlignment="Right" />
                        <TextBlock Text="正在处理文件时，请保持这个窗口打开。" FontSize="12" Foreground="#91978B" Margin="0,30,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="UninstallPanel" Visibility="Collapsed">
                        <TextBlock Text="暂时收起这间书房" FontSize="30" FontWeight="Bold" Margin="0,10,0,12" />
                        <TextBlock Text="我们会移除应用与快捷方式。你账号里的笔记仍然保留。" Foreground="#7A8174" Margin="0,0,0,24" LineHeight="24" />
                        <Border CornerRadius="14" Background="#F2F1E7" Padding="20">
                            <StackPanel>
                                <TextBlock Text="默认保留本机资料" FontWeight="SemiBold" />
                                <TextBlock Text="草稿、登录状态、缓存与已下载的语音模型，重装后仍可使用。" Foreground="#7A8174" FontSize="13" Margin="0,12,0,0" LineHeight="23" />
                                <CheckBox x:Name="DeleteLocalData" Content="同时清除这台电脑的本机资料" />
                                <TextBlock Text="勾选后，未同步草稿将无法恢复。请先保存或导出。账号与云端笔记不会被删除。" Foreground="#A57850" FontSize="12" Margin="26,10,0,0" LineHeight="22" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="UninstallDirectoryText" Foreground="#7A8174" FontSize="12" Margin="0,22,0,0" LineHeight="22" />
                    </StackPanel>
                    <StackPanel x:Name="DonePanel" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,-30,0,0">
                        <TextBlock Text="✦" FontSize="56" Foreground="#CFA368" Margin="0,0,0,14" />
                        <TextBlock x:Name="DoneTitle" Text="书房准备好了" FontSize="30" FontWeight="Bold" />
                        <TextBlock x:Name="DoneMessage" Text="带上一颗好奇心，开始今天的学习。" Foreground="#7A8174" Margin="0,16,0,0" LineHeight="25" />
                    </StackPanel>
                    <Border x:Name="LicensePanel" Background="#FFFCF4" Visibility="Collapsed" Height="{Binding ElementName=PageScroller, Path=ViewportHeight}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="PolyForm Noncommercial 1.0.0" FontSize="20" FontWeight="Bold" Margin="0,10,0,16" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LicenseText" FontSize="12" LineHeight="21" /></ScrollViewer>
                            <Button Grid.Row="2" Content="返回须知" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Margin="0,16,0,0" Click="CloseLicense_Click" />
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
                <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" Foreground="#A44E3B" FontSize="12" Margin="0,14,0,0" LineHeight="20" AutomationProperties.LiveSetting="Assertive" />
                <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,18,0,0">
                    <Button x:Name="BackButton" Content="上一步" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Click="Back_Click" Visibility="Collapsed" />
                    <Button x:Name="PrimaryButton" Content="继续" HorizontalAlignment="Right" MinWidth="138" IsDefault="True" IsEnabled="False" Click="Primary_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
