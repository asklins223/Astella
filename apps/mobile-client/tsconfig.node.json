{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "rootDir": "../..",
    "paths": {
      "@astella/shared": ["../../packages/shared/src/index.ts"],
      "@astella/shared/*": [
        "../../packages/shared/src/contracts/*.ts",
        "../../packages/shared/src/*.ts",
        "../../packages/shared/src/*/index.ts"
      ]
    }
  },
  "include": ["vite.config.ts", "shared-alias.ts", "scripts/**/*.mjs"]
}
