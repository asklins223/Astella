{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    // `@astella/shared` 的契约里有几条**只出现在类型位置**的边（safe-error、
    // content-hash 那几种带 node: 的工具）。tsc 会把它们读进程序里，所以要给 node 的类型；
    // 运行时那一侧由 `vite build` 把关——它真的把 node 内置模块带进图里就会当场报错，
    // 2026-10-12 首次构建验过这条边界。
    "types": ["vite/client", "node"],
    "rootDir": "../..",
    "paths": {
      "@astella/shared": ["../../packages/shared/src/index.ts"],
      "@astella/shared/*": [
        "../../packages/shared/src/contracts/*.ts",
        "../../packages/shared/src/*.ts",
        "../../packages/shared/src/*/index.ts"
      ],
      "@/*": ["../../apps/mobile-client/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "src/**/*.d.ts"]
}
