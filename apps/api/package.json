    "@smithy/node-http-handler": "^4.9.7",
    "@types/ws": "^8.18.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "lib0": "^0.2.117",
    "nodemailer": "^7.0.13",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.0",
    "prosemirror-model": "1.25.11",
