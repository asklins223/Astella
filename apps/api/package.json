    "test:email-verification:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/email-verification-postgres.integration.ts",
    "test:learning-objective-topology:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/learning-objective-content-topology-w1.integration.ts",
    "test:companion-discovery-http:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/companion-discovery-http-postgres.integration.ts",
    "test:plan44-sql:postgres": "node --import tsx --test --test-concurrency=1 --test-force-exit src/integration-tests/plan44-sql-parses-postgres.integration.ts",
    "test:plan44-excerpt:postgres": "node --import tsx --test --test-concurrency=1 --test-force-exit src/integration-tests/plan44-past-excerpt-postgres.integration.ts",
    "test:object-storage:s3": "node --import tsx --test --test-concurrency=1 src/integration-tests/object-storage-transfers.integration.ts",
    "test:ai-consent:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/ai-consent-signing-postgres.integration.ts",
    "test:note-collaboration:postgres": "node --import tsx --test --test-concurrency=1 src/integration-tests/note-collaboration-postgres.integration.ts",
    "test:object-storage:replicas": "ASTELLA_RUN_STORAGE_REPLICA_TEST=1 node --import tsx --test src/integration-tests/object-storage-replicas.integration.ts",
