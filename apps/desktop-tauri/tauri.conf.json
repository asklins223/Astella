{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astella",
  "version": "2.0.6",
  "identifier": "com.astella.desktop",
  "build": {
    "frontendDist": "../desktop-client/out/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
