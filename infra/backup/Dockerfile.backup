# OPS-01: Backup runner container (ADR-0007)
#
# Contains: age (encryption), mc (MinIO client), pg_dump (PostgreSQL client),
#           cron (scheduler), curl/jq (health checks)
#
# This container runs the Alpha backup infrastructure:
#   1. setup-backup-infrastructure.sh — generate age keys + create S3 bucket
#   2. alpha-backup-cron.sh — scheduled backup/rotate/freshness-check
#   3. rc-restore-verify.sh — RC restore verification
#
# Usage in docker-compose.alpha.yml:
#   docker compose -f docker-compose.alpha.yml run --rm backup-runner init
#   docker compose -f docker-compose.alpha.yml run --rm backup-runner backup
#   docker compose -f docker-compose.alpha.yml run --rm backup-runner restore-verify

FROM golang:1.24.9-alpine3.22 AS mc-build
COPY infra/storage-backup/build-client.sh /build-client.sh
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build sh /build-client.sh

FROM alpine:3.20

# Install: PostgreSQL client (pg_dump/pg_restore), age (encryption),
# MinIO client (mc), cron, curl, jq, bash, coreutils
RUN apk add --no-cache \
    postgresql16-client \
    age \
    curl \
    jq \
    bash \
    python3 \
    coreutils \
    ca-certificates \
    && pg_dump --version && age --version
COPY --from=mc-build /out/mc /usr/local/bin/mc
COPY --from=mc-build /out/LICENSE.mc /usr/share/licenses/mc/LICENSE
RUN mc --version

# Copy backup scripts
COPY infra/backup/backup.sh /opt/astella/backup.sh
COPY infra/backup/restore.sh /opt/astella/restore.sh
COPY infra/backup/rotate.sh /opt/astella/rotate.sh
COPY infra/backup/freshness-check.sh /opt/astella/freshness-check.sh
COPY infra/backup/manifest.schema.json /opt/astella/manifest.schema.json
COPY infra/backup/setup-backup-infrastructure.sh /opt/astella/setup-backup-infrastructure.sh
COPY infra/backup/alpha-backup-cron.sh /opt/astella/alpha-backup-cron.sh
COPY infra/backup/rc-restore-verify.sh /opt/astella/rc-restore-verify.sh
RUN chmod +x /opt/astella/*.sh

WORKDIR /opt/astella

# Default entrypoint: show available commands
CMD ["bash", "-c", "echo 'Usage: init | backup | restore-verify | freshness-check | cron'; exit 0"]
